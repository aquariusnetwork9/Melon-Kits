# Corpus and runtime artefacts. Several of these contain raw 2b2t chat, which routinely
# carries coordinates -- none of it may ever reach a commit.
corpus/

# Chat-bearing data files, including the .gz.tmp a crash or a full disk leaves behind
# mid-compression (*.jsonl.gz does NOT match *.jsonl.gz.tmp).
*.jsonl
*.jsonl.gz
*.gz.tmp

# Logs, including RotatingFileHandler backups collector.log.1 .. .5 (*.log does not match).
*.log
*.log.*
*.log.gz

# Collector runtime state. The trailing-glob forms also cover the .tmp and .bak
# generations written during an atomic replace.
state.json*
status.json*
collector.json
*.lock

# Kit app. The ledger holds chat (redacted, but still chat) plus every decision and its
# reason, and the config holds guild/channel/role ids. The *.example.json files are the
# committed templates.
#
# lexicon.json stays ignored even though lexicon.example.json now ships populated: the
# template is a starting point, and a server that tunes its own list -- adding spellings its
# players actually use, or an `exceptions` entry for a place name that keeps matching -- must
# not have that quietly overwritten by a pull.
melonkit.json
lexicon.json
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
# Backups taken by deploy/reset_tickets.py. A trailing suffix means *.sqlite3 does NOT
# match these, and they are a full copy of a ledger containing chat.
*.sqlite3.bak-*
*.sqlite3.bak

# A bot token must never reach a commit. It is read from the environment, not from config,
# but an .env written by hand is the obvious way round that.
.env

# Bulk-dump mining. tokens.tsv and the reports are real 2b2t chat -- including
# whatever terms you were looking for -- and *.csv covers both the dump itself and
# anything export_csv.py writes.
*.csv
*.tsv
tokens.tsv
*-report.txt
vcdb-*/

# Python
*.pyc
__pycache__/
.venv/
